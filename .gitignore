# ── Python ─────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# ── Tooling caches ─────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.benchmarks/
.coverage
coverage.xml
report.xml

